# Example environment configuration for Zoho Desk MCP Server
# Copy this file to .env and fill in your actual credentials

# Your Zoho OAuth access token
# Get this from: https://api-console.zoho.com/
ZOHO_ACCESS_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Zoho Desk Organization ID
# Find this in: Setup > API > API Settings
ZOHO_ORG_ID=123456789

# Zoho Desk API Base URL (optional)
# Default: https://desk.zoho.com/api/v1
# For EU: https://desk.zoho.eu/api/v1
# For India: https://desk.zoho.in/api/v1
# For China: https://desk.zoho.com.cn/api/v1
# For Australia: https://desk.zoho.com.au/api/v1
ZOHO_DESK_API_BASE=https://desk.zoho.com/api/v1
